<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EyeReminder.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Eye Reminder">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*">
        <!-- Barra de título personalizada -->
        <Grid x:Name="AppTitleBar" Height="40" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE890;" FontSize="14" />
                <TextBlock Text="Eye Reminder" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="ContentPanel" Padding="28,12,28,28" Spacing="20" MaxWidth="520">

                <!-- Tarjeta con la cuenta regresiva -->
                <Border Padding="24"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.CountdownText, Mode=OneWay}"
                                   HorizontalAlignment="Center"
                                   FontSize="64"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display" />
                        <ProgressBar Value="{x:Bind ViewModel.ElapsedProgress, Mode=OneWay}" Maximum="100" />
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                            <Run Text="Descansos completados hoy:" />
                            <Run Text="{x:Bind ViewModel.BreaksCompleted, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Acciones -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Sin recuadro de foco: al abrir la app el foco inicial caía en este botón y dibujaba un borde blanco. -->
                    <Button HorizontalAlignment="Stretch"
                            FocusVisualPrimaryThickness="0"
                            FocusVisualSecondaryThickness="0"
                            Command="{x:Bind ViewModel.ToggleRunCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind ViewModel.ToggleRunGlyph, Mode=OneWay}" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.ToggleRunLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.BreakNowCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE890;" FontSize="14" />
                            <TextBlock Text="Descansar ahora" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Button HorizontalAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.IsOnBreak, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SkipBreakCommand}"
                        Content="Omitir este descanso" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
