<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EyeReminder.Views.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EyeReminder.Views"
    Title="Eye Reminder - Descanso">

    <!-- Ventana transparente: solo se ve el notch dibujado abajo, con bordes suavizados. -->
    <Window.SystemBackdrop>
        <views:TransparentBackdrop />
    </Window.SystemBackdrop>

    <!-- Sin RequestedTheme: los colores siguen el modo claro u oscuro de Windows. -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid x:Name="IslandContent" Opacity="0" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="ContentTransform" ScaleX="0.9" ScaleY="0.9" TranslateY="-8" />
            </Grid.RenderTransform>

            <!--
                Forma del notch en 400 x 60: pegado al borde superior, esquinas inferiores de
                radio 22 y "orejas" cóncavas de radio 12 que lo funden con el borde de la pantalla.
            -->
            <!-- Gris de fondo de WinUI 3 (#202020 en oscuro, #F3F3F3 en claro) con el borde sutil de las tarjetas. -->
            <Path Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                  Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                  StrokeThickness="1"
                  Data="M 0,0 A 12,12 0 0 1 12,12 L 12,38 A 22,22 0 0 0 34,60 L 366,60 A 22,22 0 0 0 388,38 L 388,12 A 12,12 0 0 1 400,0 Z" />

            <Grid Padding="30,0,26,2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Grid Width="34" Height="34" VerticalAlignment="Center">
                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.18" />
                    <FontIcon Glyph="&#xE890;" FontSize="17" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="{x:Bind ViewModel.Title}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Column="2" Width="40" Height="40" VerticalAlignment="Center">
                    <ProgressRing Width="40"
                                  Height="40"
                                  IsIndeterminate="False"
                                  Maximum="100"
                                  Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SecondsRemaining, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
